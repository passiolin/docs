# 阿里云账单适配器配置。复制为同目录 .env 后填写, .env 不入 git。

# RAM 服务账号凭据(账单只读: bss:QueryAccountBill)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 站点: 国内站 business.aliyuncs.com; 国际站 business-intl.aliyuncs.com
# ALIYUN_BSS_HOST=business.aliyuncs.com

# 飞书机器人 Webhook(报表与突增告警都发这里; 变量名也兼容 FEISHU_WEBHOOK)
FEISHU_WEBHOOK_URL=

# 突增判定参数
# SPIKE_MIN_AMOUNT=100      # 突增金额下限(元), 低于不算突增
# SPIKE_RATIO=2.0           # 超出金额需达到基线的倍数
# SPIKE_BASELINE_WEEKS=4    # 基线取前几周同星期几的中位数
# REPORT_DELAY_DAYS=1       # 日报/时报评估今天之前第 N 天, 默认 1=昨天(金额可能随出账重算)
# COST_RETRY_ATTEMPTS=3     # 云 API 瞬时故障(5xx/限流)重试次数
# COST_RETRY_DELAY=3        # 首次重试等待秒数, 之后每次翻倍

# 部署环境 TLS 拦截时设为 1
# COST_INSECURE_TLS=0
