# AWS Cost Explorer 凭据: IAM 用户(仅程序化访问), 只给账单只读权限
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STS 临时凭据才需要
# AWS_SESSION_TOKEN=
# CE 签名区域, 默认 us-east-1; 中国区填 cn-northwest-1
# AWS_REGION=us-east-1
# CE 服务端点, 一般不用改
# AWS_CE_HOST=ce.us-east-1.amazonaws.com

# 飞书群机器人 webhook(也认 FEISHU_WEBHOOK_URL)
FEISHU_WEBHOOK=

# ---- 报表规则(与阿里云同名同义, 唯金额单位是美元) ----
# CE 账单滞后约一天, 默认 T-2 更稳; 想看昨天设 1
# REPORT_DELAY_DAYS=2
# 突增金额下限(美元); 阿里云是 100 元≈14 美元, 这里取同量级
# SPIKE_MIN_AMOUNT=20
# SPIKE_RATIO=2.0
# SPIKE_BASELINE_WEEKS=4

# ---- 其它 ----
# 云 API 瞬时故障(5xx/限流)重试次数与首次等待秒数
# COST_RETRY_ATTEMPTS=3
# COST_RETRY_DELAY=3
