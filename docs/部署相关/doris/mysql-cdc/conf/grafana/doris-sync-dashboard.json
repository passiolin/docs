          "expr": "mysql_doris_source_fetch_lag_seconds",
          "legendFormat": "{{pipeline}} fetch",
          "refId": "A"
        },
        {
          "expr": "mysql_doris_source_emit_lag_seconds",
          "legendFormat": "{{pipeline}} emit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
