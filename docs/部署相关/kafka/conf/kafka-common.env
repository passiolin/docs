# ============================================================
# kafka-common.env —— KRaft 集群共享基线(实测 Kafka 4.3.1)
# 三台一致;节点差异由 gen-node-env.sh 注入(node.id/advertised)
# docker 用法:docker run --env-file kafka-common.env --env-file kafka-node.env
# ============================================================

# ---------- 角色:KRaft 合并模式(broker+controller 同进程) ----------
KAFKA_PROCESS_ROLES=broker,controller
# 仲裁选民(id@ip:9093,三台一致;9093 是 controller 专用端口)
KAFKA_CONTROLLER_QUORUM_VOTERS=1@10.10.12.128:9093,2@10.10.12.129:9093,3@10.10.12.130:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
# advertised.listeners 由节点 env 注入(必须写本机真实 IP)

# ---------- 集群默认值(架构拍板:3 节点基线) ----------
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1
# 内部 topic 副本(3 节点环境给 2,__consumer_offsets 等)
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=2
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=2
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# ---------- 保留与分段(磁盘拍板) ----------
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# ---------- 行为基线(定一次) ----------
# 禁自动建 topic:topic 是资产,显式创建(巡检 K12 漂移项的源头治理)
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# ---------- JVM(容器/主机内存拍板:4G 机器给 1G 堆) ----------
KAFKA_HEAP_OPTS=-Xmx1g -Xms1g

# ---------- 数据目录(挂载宿主) ----------
KAFKA_LOG_DIRS=/var/lib/kafka/data
