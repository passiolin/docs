# ============================================================
# role-mgr.cnf —— MGR 集群角色增量(实测 8.4.11,单主模式)
# 用法:由 gen-node-conf.sh 与 common.cnf 拼成节点完整 my.cnf;
#       本文件三台一致,节点差异(见脚本注入):server_id /
#       report_host / group_replication_local_address
# ============================================================
[mysqld]
# MGR 依赖 binlog + GTID(common 已前置)
plugin_load_add = group_replication.so

# 组身份:UUID 全组一致(生成一次,勿改)
loose-group_replication_group_name = 7a1c8e2a-6b4d-4e39-9f21-0c58d2ab3401

# 组成员通信地址(seed 列表按实际三台 IP 修改)
loose-group_replication_group_seeds = 10.10.12.115:33061,10.10.12.116:33061,10.10.12.117:33061

# 仅允许内网网段加入(默认即私有网段,显式声明便于审计)
loose-group_replication_ip_allowlist = 10.10.12.0/24

# 单主模式:全组只有一个写点(与另一项配套,改就一起改)
loose-group_replication_single_primary_mode = ON
loose-group_replication_enforce_update_everywhere_checks = OFF

# 故障切换语义:新主接管前先补齐本地事务,避免读到旧数据
loose-group_replication_consistency = BEFORE_ON_PRIMARY_FAILOVER

# 受控启动:节点重启后不自动入组(由运维/脚本 START GROUP_REPLICATION);
# 整组冷启 runbook 见第 5 篇;稳定期可改 ON 实现成员自动回归
loose-group_replication_start_on_boot = OFF
# 引导位只允许运行时临时打开,严禁写死 ON(双引导=脑裂)
loose-group_replication_bootstrap_group = OFF
# 恢复通道走 TLS:InnoDB Cluster 收编后恢复账号要求安全连接,
# 不开会报 "Authentication requires secure connection" 无法入组(实测)
loose-group_replication_recovery_use_ssl = ON
