# ============================================================
# role-standalone.cnf —— 单机角色增量(实测 8.4.11)
# 用法:与 common.cnf 同目录拼接生效;容器部署时两个文件
#       一起放进 /data/mysql/conf/(官方镜像按文件名序加载)
# 单机没有增量项:binlog/GTID 已在 common 里前置,
# 复制类参数只有进集群才需要(见 role-mgr.cnf)。
# 保留本文件是为了部署脚本对三种角色走同一条路径。
# ============================================================
[mysqld]
# (单机无增量,留空)
