# 部署到 /etc/sub2api-patrol/sub2api-patrol.env，权限 600、属主 root。
# 本文件含管理员 Key 与群机器人 webhook，不要提交仓库。
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_API_KEY=<管理员 API Key>
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<hook_id>
# 群机器人开启「签名校验」时再填：
# FEISHU_SECRET=<签名密钥>
# 低额度阈值（美元），默认 1000
# LOW_BALANCE_THRESHOLD=1000
# 报错回看窗口（分钟），默认 60
# ERROR_WINDOW_MINUTES=60
# 自动启停：任一窗口已用 ≥99% 停用，回落到 90% 以下自动恢复
# AUTO_SUSPEND=true
# AUTO_SUSPEND_THRESHOLD=99
# AUTO_RESUME_THRESHOLD=90
# 状态文件记录本工具停用过的账号，只有这些账号会被自动恢复
# AUTO_SUSPEND_STATE=/var/lib/sub2api-patrol/auto_suspend.json
