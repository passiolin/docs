# 部署到 /etc/cert-monitor/cert-monitor.env,权限 600、属主 root。
# 群机器人 webhook 只放目标机,不要提交仓库。
TARGETS_FILE=/etc/cert-monitor/targets.conf
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<hook_id>
# 机器人开启「签名校验」时再填:
# FEISHU_SECRET=<签名密钥>

# 单次连接/握手超时秒数,默认 8
# PROBE_TIMEOUT=8
# 目标行没写 warn/crit 时的默认阈值(天)
# WARN_DAYS=30
# CRIT_DAYS=7
